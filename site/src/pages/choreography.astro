---
import BaseLayout from "../layouts/BaseLayout.astro";

const credentials = [
  "10 years of competitive dance training (Ballet, Jazz, Lyrical, Contemporary, Hip-Hop, Tap)",
  "Virginia Dance Company Alum (Selective College-Level Club Dance)",
  "Studied Dance and Drama from the University of Virginia",
  "10+ Choreography & Dance Captain credits on shows like Legally Blonde, Catch Me if You Can, American Idiot, and more",
  "Winner of the 2022 NCA Cappies Award for Choreography",
  "Winner of the 2022 NCA Cappies Award for Female Dancer in a Musical",
  "Independent Artist Program at Steps on Broadway",
  "Regional and college performance credits in productions including Newsies and Natasha, Pierre & The Great Comet of 1812"
];

const steps = [
  {
    num: "01",
    title: "Zoom Consultation (15–30 Mins)",
    description: "We'll discuss your preferences, style, and goal prescreens. I bring tailored song suggestions that highlight your strengths while meeting Common Prescreen requirements."
  },
  {
    num: "02",
    title: "Payment & Track Selection",
    description: "Payment ($450 via Venmo or preferred option) is due after our call. I will follow up with your top song choices and the best 1-minute cut options for each."
  },
  {
    num: "03",
    title: "Video Delivery",
    description: "Delivered within 1–3 weeks of track selection/payment via unlisted YouTube links. Includes step-by-step breakdown with counts and full demo videos facing both away and towards the camera."
  },
  {
    num: "04",
    title: "Revisions Included",
    description: "Includes one round of choreography edits to guarantee the final combination feels comfortable and fits you perfectly!"
  }
];

// Replace with your YouTube video IDs
const choreographyReels = [
  { title: "Musical Theatre Jazz Combo", youtubeId: "qCmk47I9BkM"},
  { title: "Positive - Legally Blonde", youtubeId: "o427FNrlYqs", start: 2222, end: 2250}
];
---

<BaseLayout title="Prescreen Choreography | Karina Yakubisin" description="Custom Musical Theatre Prescreen Choreography for Auditions">
  <section class="space-y-12 py-4">
    
    <!-- Hero Header -->
    <div class="space-y-3">
      <p class="eyebrow">Custom College Audition Material</p>
      <h1 class="text-3xl sm:text-5xl">Prescreen Choreography</h1>
      <p class="text-base sm:text-lg muted leading-relaxed max-w-3xl">
        I’m so glad you’re interested in using my choreography! I work with artists of all experience levels - whether you're trying dance for the first time or possess advanced technical training.
      </p>
    </div>


    <!-- Pricing & Package -->
    <div class="panel p-6 sm:p-8 flex flex-col md:flex-row gap-6 justify-between items-start md:items-center">
      <div class="space-y-1">
        <span class="eyebrow">All-Inclusive Package</span>
        <h2 class="text-2xl">Customized Prescreen Choreography</h2>
        <p class="muted text-sm max-w-lg">
          A full-service package guiding you from track selection and cuts to custom combo creation and video instruction.
        </p>
      </div>
      <div class="text-left md:text-right shrink-0">
        <div class="text-3xl sm:text-4xl font-bold font-serif text-[rgb(var(--accent))]">$450</div>
        <span class="text-xs muted">Flat rate package</span>
      </div>
    </div>

    <!-- My Credentials Section -->
    <div class="panel p-6 sm:p-8 space-y-6">
      <div class="space-y-1">
        <p class="eyebrow">Background & Experience</p>
        <h2 class="text-2xl">My Credentials</h2>
      </div>

      <div class="grid md:grid-cols-12 gap-8 items-center">
        <!-- Photo Space -->
        <div class="md:col-span-5 aspect-[3/4] media-frame flex items-center justify-center">
          <img 
            src="/images/credentials.JPEG" 
            alt="Karina Yakubisin Dancing" 
            class="w-full h-full object-cover"
            onerror="this.onerror=null; this.parentElement.querySelector('.placeholder').classList.remove('hidden'); this.classList.add('hidden');"
          />
          <div class="placeholder hidden text-center p-6 space-y-2">
            <svg class="w-8 h-8 mx-auto muted" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
            </svg>
            <p class="text-xs muted">Add image at <br/><code class="text-xs">public/images/credentials.JPEG</code></p>
          </div>
        </div>

        <!-- Credentials List -->
        <div class="md:col-span-7">
          <ul class="space-y-3">
            {credentials.map((item) => (
              <li class="flex items-start gap-3 text-sm leading-relaxed">
                <span class="w-1.5 h-1.5 rounded-full bg-[rgb(var(--accent))] shrink-0 mt-2"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>

    <!-- Process -->
    <div class="space-y-6">
      <h2 class="text-2xl">How It Works</h2>
      <div class="grid gap-6 sm:grid-cols-2">
        {steps.map((step) => (
          <div class="panel p-6 space-y-2">
            <span class="eyebrow">{step.num}</span>
            <h3 class="text-lg font-semibold">{step.title}</h3>
            <p class="text-sm muted leading-relaxed">{step.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- My Choreography -->
    <div class="space-y-6 pt-6 border-t border-[rgb(var(--line))]">
      <div class="space-y-1">
        <p class="eyebrow">Video Samples</p>
        <h2 class="text-2xl">My Choreography</h2>
      </div>

      <div class="grid gap-6 sm:grid-cols-2">
        {choreographyReels.map((reel) => (
          <div class="space-y-2">
            <div class="aspect-video media-frame flex items-center justify-center">
                {reel.youtubeId ? (
                    <iframe 
                    class="w-full h-full" 
                    src={`https://www.youtube.com/embed/${reel.youtubeId}?start=${reel.start || 0}${reel.end ? `&end=${reel.end}` : ''}&rel=0`} 
                    title={reel.title} 
                    frameborder="0" 
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
                    allowfullscreen
                    ></iframe>
                ) : (
                    <div class="text-center p-6 space-y-2">
                    <svg class="w-8 h-8 mx-auto muted" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
                    </svg>
                    <p class="text-xs muted">Add YouTube ID in <br/><code>choreographyReels</code> array</p>
                    </div>
                )}
            </div>
            <h3 class="text-sm font-semibold">{reel.title}</h3>
          </div>
        ))}
      </div>
    </div>

    <!-- Contact CTA -->
    <div class="panel p-8 text-center space-y-4">
      <p class="muted text-sm max-w-md mx-auto">Get in touch to schedule your Zoom consultation or ask any questions before getting started.</p>
      <div>
        <a href="/contact" class="btn text-base hover:text-[rgb(var(--accent-hover))]">
          Book Choreography Consultation &rarr;
        </a>
      </div>
    </div>

  </section>
</BaseLayout>