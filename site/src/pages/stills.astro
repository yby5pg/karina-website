---
import BaseLayout from "../layouts/BaseLayout.astro";
import { client, urlFor } from "../lib/sanity";

// Query plain raw image field from Sanity
const sanityStills = await client.fetch(`*[_type == "still"]`);

// Quick console log during development (visible in terminal running `npm run dev`)
console.log("Sanity Stills Fetch:", sanityStills);

const stills =
  sanityStills && sanityStills.length > 0
    ? sanityStills.map((item: any) => {
        let imageUrl = "";
        
        if (item?.image?.asset) {
          try {
            imageUrl = urlFor(item.image).width(1200).auto('format').url();
          } catch (e) {
            console.error("Url generation error:", e);
          }
        }

        return {
          id: item._id,
          src: imageUrl,
          rawImage: item.image,
        };
      })
    : [];
---

<BaseLayout title="Production Stills | Karina Yakubisin">
  <section class="container mt-12 md:mt-20 mb-24">
    <h1 class="text-4xl md:text-5xl font-semibold">Production Stills</h1>

    {stills.length === 0 && (
      <p class="mt-8 text-neutral-500">No stills found or failed to fetch from Sanity.</p>
    )}

    <!-- Adjusted grid for larger, centered frames -->
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3 items-stretch">
      {stills.map((still: any) => (
        <div class="media-frame group overflow-hidden border border-neutral-200 dark:border-neutral-800 rounded-lg bg-neutral-900/5 dark:bg-neutral-900 flex items-center justify-center min-h-[320px]">
          {still.src ? (
            <img
              src={still.src}
              alt="Production photo"
              class="w-full h-full max-h-[420px] aspect-[4/3] object-contain object-center transition-transform duration-300 group-hover:scale-105 p-2"
              loading="lazy"
              decoding="async"
            />
          ) : (
            <div class="p-4 text-xs text-red-500 bg-neutral-100 dark:bg-neutral-900 aspect-[4/3] flex flex-col justify-center overflow-auto w-full">
              <strong>Image missing reference</strong>
              <pre class="mt-2 text-[10px]">{JSON.stringify(still.rawImage, null, 2)}</pre>
            </div>
          )}
        </div>
      ))}
    </div>
  </section>
</BaseLayout>