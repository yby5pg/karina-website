---
import BaseLayout from "../layouts/BaseLayout.astro";
import { client } from "../lib/sanity";

// Utility to convert YouTube URL to embed format
function getYouTubeEmbedUrl(url: string) {
  if (!url) return "";
  const regExp = /^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|\&v=)([^#\&\?]*).*/;
  const match = url.match(regExp);
  return match && match[2].length === 11
    ? `https://www.youtube-nocookie.com/embed/${match[2]}`
    : url;
}

let sanityReels = [];

try {
  sanityReels = await client.fetch(
    `*[_type == "reel"] | order(order asc) {
      _id,
      title,
      youtubeUrl
    }`
  );
} catch (error) {
  console.error("Failed to fetch reels from Sanity:", error);
}
---

<BaseLayout title="Reels | Karina Yakubisin">
  <section class="container mt-12 md:mt-20 mb-24">
    <h1 class="text-4xl md:text-5xl font-semibold">Reels</h1>
    
    <div class="mt-10 grid gap-8 sm:grid-cols-2">
      {sanityReels && sanityReels.length > 0 ? (
        sanityReels.map((r: any) => (
          <div class="space-y-3">
            <div class="media-frame aspect-video relative overflow-hidden block w-full bg-black">
              <iframe
                src={getYouTubeEmbedUrl(r.youtubeUrl)}
                title={r.title}
                class="w-full h-full border-0"
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                allowfullscreen
              ></iframe>
            </div>
            <h2 class="text-lg font-semibold">{r.title}</h2>
          </div>
        ))
      ) : (
        <p class="muted">No reels found.</p>
      )}
    </div>
  </section>
</BaseLayout>