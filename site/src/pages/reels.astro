---
import BaseLayout from "../layouts/BaseLayout.astro";

const reels = [
  {
    title: "Dance Reel 2026",
    youtubeId: "9FUEqkEGpgQ",
  },
  {
    title: "'You Phoebe Me' - As You Like It",
    youtubeId: "8qf-4amKE0M",
  },
  {
    title: "It Only Takes a Moment — Hello Dolly",
    youtubeId: "ZqAKQenhasQ",
  },
  {
    title: "Tap Combo",
    youtubeId: "J-vWSyw_vx0",
  },
];
---

<BaseLayout title="Reels — Karina Yakubisin">
  <section class="container mt-10">
    <h1 class="mt-3 text-3xl md:text-4xl">Reels</h1>
  </section>

  <section class="container mt-8 mb-16">
    <div class="grid gap-8 md:grid-cols-2">
      {reels.map((r) => (
        <div>
          <div class="media-frame">
            <iframe
              class="w-full aspect-video"
              src={`https://www.youtube.com/embed/${r.youtubeId}?rel=0`}
              title={r.title}
              frameborder="0"
              allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
              allowfullscreen
            ></iframe>
          </div>
          <p class="mt-3 text-sm font-semibold">{r.title}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
