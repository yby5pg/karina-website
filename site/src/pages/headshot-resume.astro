---
import BaseLayout from "../layouts/BaseLayout.astro";
import { client, urlFor } from "../lib/sanity";

const data = await client.fetch(
  `*[_type == "headshotResume"][0] {
    downloadableHeadshot,
    "resumeUrl": resumePdf.asset->url
  }`
);

let displayHeadshotSrc = "/images/headshots/headshot1.JPG";
let downloadHeadshotSrc = "/images/headshots/headshot1.JPG";

if (data?.downloadableHeadshot) {
  try {
    // Web-optimized display image (~600px width, webp/avif via auto format)
    displayHeadshotSrc = urlFor(data.downloadableHeadshot)
      .width(800)
      .auto("format")
      .quality(80)
      .url();

    // High-resolution source reserved strictly for full download
    downloadHeadshotSrc = urlFor(data.downloadableHeadshot)
      .width(2000)
      .auto("format")
      .quality(90)
      .url();
  } catch (e) {
    console.error("Headshot URL error:", e);
  }
}

const resumePdfUrl = data?.resumeUrl || "/resume.pdf";
---

<BaseLayout title="Headshot & Resume | Karina Yakubisin">
  <!-- Preload hero headshot image to boost LCP -->
  <link rel="preload" as="image" href={displayHeadshotSrc} slot="head" />

  <section class="container mt-12 md:mt-20 mb-24">
    <div class="mb-10">
      <h1 class="text-4xl md:text-5xl font-semibold">Headshot &amp; Resume</h1>
      <p class="mt-2 muted">Hover over either document to download.</p>
    </div>

    <div class="grid gap-8 md:grid-cols-2 items-start">
      <!-- Headshot Card -->
      <div class="doc-card media-frame group">
        <div class="viewer-wrapper">
          <img
            src={displayHeadshotSrc}
            alt="Karina Yakubisin Headshot"
            class="w-full h-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div class="overlay">
          <a
            href={downloadHeadshotSrc}
            download="Karina_Yakubisin_Headshot.jpg"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-on-dark shadow-xl"
          >
            Download Headshot
          </a>
        </div>
      </div>

      <!-- Resume PDF Card -->
      <div class="doc-card media-frame group">
        <div class="viewer-wrapper pdf-viewer">
          <iframe
            src={`${resumePdfUrl}#toolbar=0&navpanes=0&scrollbar=0&view=FitH`}
            title="Karina Yakubisin Resume Preview"
            loading="eager"
            class="pdf-iframe"
          ></iframe>
        </div>
        <div class="overlay">
          <a
            href={resumePdfUrl}
            download="Karina_Yakubisin_Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            class="btn-on-dark shadow-xl"
          >
            Download Resume (PDF)
          </a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .doc-card {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1.35; /* Standard document ratio */
    overflow: hidden;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .doc-card:hover {
    transform: translateY(-4px);
  }

  .viewer-wrapper {
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: hidden;
  }

  .viewer-wrapper img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* PDF Fitted Container Styling */
  .pdf-viewer {
    position: relative;
    width: 100%;
    height: 100%;
    background: #ffffff;
  }

  .pdf-iframe {
    width: 100%;
    height: 100%;
    border: none;
    display: block;
    object-fit: contain;
  }

  /* Hover Overlay */
  .overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    background: rgba(13, 12, 11, 0.65);
    backdrop-filter: blur(3px);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.3s ease;
    padding: 1.5rem;
  }

  .doc-card:hover .overlay,
  .doc-card:focus-within .overlay {
    opacity: 1;
    pointer-events: auto;
  }

  .overlay .btn-on-dark {
    pointer-events: auto;
    cursor: pointer;
  }

  @media (max-width: 640px) {
    .overlay {
      opacity: 0.9;
      pointer-events: auto;
      background: rgba(13, 12, 11, 0.45);
    }
  }
</style>